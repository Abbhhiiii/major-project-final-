SURVEILLANCE_ENVIRONMENT=development
SURVEILLANCE_DATABASE_URL=sqlite:///./surveillance.db
SURVEILLANCE_LOG_LEVEL=INFO
# JSON syntax is required when overriding tuple/list settings.
SURVEILLANCE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SURVEILLANCE_UPLOAD_DIRECTORY=uploads
SURVEILLANCE_MAX_VIDEO_SIZE_MB=250
SURVEILLANCE_FRAME_SAMPLE_FPS=2
SURVEILLANCE_PLAYBACK_SPEED=4
SURVEILLANCE_TEMPORAL_CLUSTER_GAP_SECONDS=5
SURVEILLANCE_ACCIDENT_MODEL_PATH=/absolute/path/to/best.pt
SURVEILLANCE_ACCIDENT_CONFIDENCE_THRESHOLD=0.5
SURVEILLANCE_FORCE_ACCEPT_VERIFICATION=true
SURVEILLANCE_SESSION_TTL_HOURS=12
SURVEILLANCE_GROQ_API_KEY=
SURVEILLANCE_GROQ_MODEL=openai/gpt-oss-20b
SURVEILLANCE_GROQ_MAX_RETRIES=2
SURVEILLANCE_REPORT_DIRECTORY=reports
SURVEILLANCE_TWILIO_ENABLED=false
SURVEILLANCE_TWILIO_ACCOUNT_SID=
SURVEILLANCE_TWILIO_AUTH_TOKEN=
SURVEILLANCE_TWILIO_API_KEY_SID=
SURVEILLANCE_TWILIO_API_KEY_SECRET=
SURVEILLANCE_TWILIO_FROM_NUMBER=
SURVEILLANCE_TWILIO_LIVE_VALIDATED=false
